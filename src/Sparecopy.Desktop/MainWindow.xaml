<Window x:Class="Sparecopy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sparecopy"
        Icon="pack://application:,,,/Assets/sparecopy.ico"
        Width="1360" Height="880" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Header}" Padding="18,9">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/sparecopy.png" Width="30" Height="30" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <TextBlock Text="Sparecopy" FontSize="21" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.HeaderText}" />
                    <Border Width="1" Height="22" Background="{DynamicResource Brush.HeaderText}" Opacity="0.25" Margin="16,0" />
                    <TextBlock Text="Family backup" FontSize="15" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.HeaderMuted}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource Brush.HeaderActive}" CornerRadius="11" Padding="11,4" Margin="0,0,12,0"
                            ToolTip="This is an early preview. Backups, devices and Sparecopy Server are coming soon.">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Brand}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="Preview · not backing up yet" FontSize="11.5" Foreground="{DynamicResource Brush.HeaderMuted}" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="ThemeButton" Style="{StaticResource HeaderButton}" Click="Theme_Click">
                        <TextBlock x:Name="ThemeGlyph" Style="{StaticResource Icon}" FontSize="16" />
                    </Button>

                    <Button x:Name="SettingsButton" Style="{StaticResource HeaderButton}" Click="Settings_Click" ToolTip="Settings"
                            AutomationProperties.Name="Settings">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="16" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Section toolbar ===== -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Toolbar}" Padding="12,0">
            <ItemsControl x:Name="ModuleBar">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource ToolbarRadio}" GroupName="MainNav"
                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                     ToolTip="{Binding Tagline}"
                                     AutomationProperties.Name="{Binding Title}"
                                     Checked="Module_Checked" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ===== Page ===== -->
        <ScrollViewer x:Name="PageScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,28">
            <ContentControl x:Name="PageHost" />
        </ScrollViewer>

        <!-- ===== Status bar ===== -->
        <Border Grid.Row="3" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0" Padding="16,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="11"
                           Text="Sparecopy Server (Docker) — coming soon" />
                <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" FontSize="11" />
            </DockPanel>
        </Border>

        <!-- ===== Toast ===== -->
        <Border x:Name="Toast" Grid.Row="0" Grid.RowSpan="4" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,26,46"
                Background="{DynamicResource Brush.ToastBg}" CornerRadius="8" Padding="16,11" MaxWidth="440">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,10,0"
                           Foreground="{DynamicResource Brush.Brand}" />
                <TextBlock x:Name="ToastText" Foreground="{DynamicResource Brush.ToastText}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
