<UserControl x:Class="Sparecopy.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Text="Settings" Style="{StaticResource PageTitle}" HorizontalAlignment="Left" Margin="0,0,0,18" />

        <!-- Appearance: this one actually works -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}" />
                <RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="Match Windows (light or dark)" Checked="Theme_Checked" Tag="System" />
                <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="Light" Checked="Theme_Checked" Tag="Light" />
                <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="Dark" Checked="Theme_Checked" Tag="Dark" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource SoonPill}">
                        <TextBlock Text="COMING SOON" Style="{StaticResource PillText}" />
                    </Border>
                    <TextBlock Text="THIS PC" Style="{StaticResource SectionLabel}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                           Text="Protect this computer: give it a name and location, choose its backup plans, and let Sparecopy run quietly in the background when Windows starts." />
                <CheckBox Content="Start Sparecopy with Windows and run backups in the background" IsEnabled="False" />
                <CheckBox Content="Show a notification when a backup finishes or fails" IsEnabled="False" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Back up this PC" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            Click="Soon_Click" Tag="Backing up this PC" />
                    <Button Content="Rename device" Style="{StaticResource GhostButton}"
                            Click="Soon_Click" Tag="Renaming devices" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource SoonPill}">
                        <TextBlock Text="COMING SOON" Style="{StaticResource PillText}" />
                    </Border>
                    <TextBlock Text="SPARECOPY SERVER" Style="{StaticResource SectionLabel}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                           Text="Connect this PC to your Sparecopy Server (running in Docker on your NAS or home server) so it shows up on the family dashboard, even from another house." />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Connect" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                            Click="Soon_Click" Tag="Connecting to Sparecopy Server" />
                    <TextBox Text="http://nas.local:8460" IsEnabled="False" />
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource SoonPill}">
                        <TextBlock Text="COMING SOON" Style="{StaticResource PillText}" />
                    </Border>
                    <TextBlock Text="ALERTS" Style="{StaticResource SectionLabel}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                           Text="Get an email when a backup fails, a device hasn't checked in for a few days, or a destination is nearly full." />
                <Button Content="Set up email alerts" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                        Click="Soon_Click" Tag="Email alerts" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="ABOUT" Style="{StaticResource SectionLabel}" />
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/sparecopy.png" Width="38" Height="38" Margin="0,0,12,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="AboutTitle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                           Text="© 2026 Bytehawk Studio. Free and open source under the MIT License." />
                <TextBlock x:Name="DataFolderText" Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="12" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
